.env
# Live compose file, generated from docker-compose.yml.dist on first init
# (never overwritten afterward — see init.sh copy_compose_file()). Keeping
# this untracked means `git pull` never silently rewrites a running
# server's compose config.
docker-compose.yml
.backup/
tmp/
__pycache__/

# Version pinning (local only)
docker-compose.override.yml
.voipbin-versions/
# Local test/setup artifacts (generated by init/start, never commit)
certs/
config/coredns/Corefile
config/dummy-gcp-credentials.json
tmp/
.test_data_initialized
.backup/
# Data backups (contain plaintext .env secrets - never commit; copy off-host)
backups/
.env.pre-restore*
.voipbin-op.lock
# RabbitMQ delayed-message plugin (downloaded on first start)
config/rabbitmq/plugins/*.ez
