.env
# Live compose file, generated from docker-compose.yml.dist on first init
# (never overwritten afterward — see the docker-compose.yml.dist copy step
# in init.sh's main(), just after .env is written). Keeping this untracked
# means `git pull` never silently rewrites a running server's compose config.
docker-compose.yml
# Live lock file, generated from versions.lock.dist on first init (same
# copy-once/never-overwrite treatment as docker-compose.yml above, for the
# same reason - it's meant to be operator-owned and updated independently
# after install, decoupled from any automated deploy path).
versions.lock
.backup/
tmp/
__pycache__/

# Version pinning (local only)
docker-compose.override.yml
.voipbin-versions/
# Local test/setup artifacts (generated by init/start, never commit)
certs/
config/coredns/Corefile
config/dummy-gcp-credentials.json
tmp/
.test_data_initialized
.backup/
# Data backups (contain plaintext .env secrets - never commit; copy off-host)
backups/
.env.pre-restore*
.voipbin-op.lock
# RabbitMQ delayed-message plugin (downloaded on first start)
config/rabbitmq/plugins/*.ez
# Concurrency lock files (VOIP-1334): acquire_file_lock() in common.sh
# creates "<target>.flock" next to any file it protects (versions.lock,
# versions.lock.dist, docker-compose.yml, docker-compose.yml.dist) - a
# zero-byte file reused across runs, never meant to be committed. Without
# this, bump-image-digest.sh/sync-compose-images.sh running against the
# tracked .dist files leaves an untracked *.flock file behind.
*.flock
