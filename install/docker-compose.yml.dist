# This is the DISTRIBUTION copy, committed to the repo. `init.sh` copies it
# to `docker-compose.yml` (untracked, install/.gitignore) on first install
# only, and never overwrites an existing `docker-compose.yml` afterward —
# not even on `--force-reinit`. That is deliberate: `docker-compose.yml` is
# the file `docker compose` actually reads (implicit cwd discovery, no `-f`
# flag anywhere in this repo's scripts), and it must stay reachable by
# `git pull` for it to be safe to keep the local, live file out of git —
# so a repo update never silently rewrites a running server's compose
# config. To pick up upstream changes from a newer docker-compose.yml.dist
# (new services, image digest bumps, etc.), diff it against your live
# docker-compose.yml and merge deliberately, or run
# scripts/sync-compose-images.sh with COMPOSE_FILE=docker-compose.yml to
# pull in just the image digest updates from versions.lock.
#
# This file is still a complete, standalone-runnable compose file in its
# own right (see scripts/sync-compose-images.sh's header comment) — the
# dist/live split changes which copy is authoritative for `docker compose`
# to read, not the file's own validity.
#
# Default log rotation for every service: without this, docker's json-file
# driver grows without bound and eventually fills the disk on a long-lived
# single-server deployment.
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  # ===========================================================================
  # Infrastructure Services
  # ===========================================================================

  # Database (Vanilla MySQL - run ./scripts/init_database.sh to initialize schema)
  db:
    image: mysql:8.0
    container_name: voipbin-db
    restart: always
    logging: *default-logging
    ports:
      - "3306:3306"
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-p${MYSQL_ROOT_PASSWORD}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 30s

  redis:
    image: redis:alpine
    container_name: voipbin-redis
    restart: always
    logging: *default-logging
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  rabbitmq:
    image: rabbitmq:3-management-alpine
    # Fixed hostname: RabbitMQ keys its mnesia data dir as rabbit@<hostname>.
    # Without this pin, every container recreate gets a new container-id
    # hostname and ORPHANS the persisted data in rabbitmq_data.
    hostname: voipbin-rabbitmq
    restart: always
    logging: *default-logging
    ports:
      - "5672:5672"
      - "15672:15672"
    # Delayed-message plugin lives in a host bind dir (config/rabbitmq/plugins)
    # mounted at a SEPARATE path and added via RABBITMQ_PLUGINS_DIR, so:
    # - container recreate does NOT re-download (offline-safe)
    # - image upgrades are NOT shadowed by a stale named volume over /plugins
    entrypoint: >
      /bin/sh -c "
      if [ ! -f /opt/rabbitmq-extra-plugins/rabbitmq_delayed_message_exchange-3.13.0.ez ]; then
        rm -f /opt/rabbitmq-extra-plugins/rabbitmq_delayed_message_exchange-*.ez 2>/dev/null;
        wget -P /opt/rabbitmq-extra-plugins/ https://github.com/rabbitmq/rabbitmq-delayed-message-exchange/releases/download/v3.13.0/rabbitmq_delayed_message_exchange-3.13.0.ez;
      fi;
      rabbitmq-plugins enable --offline rabbitmq_delayed_message_exchange;
      exec docker-entrypoint.sh rabbitmq-server
      "
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_DEFAULT_USER}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_DEFAULT_PASS}
      - RABBITMQ_PLUGINS_DIR=/opt/rabbitmq/plugins:/opt/rabbitmq-extra-plugins
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
      - ./config/rabbitmq/plugins:/opt/rabbitmq-extra-plugins
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 30s

  # PostgreSQL + pgvector - rag-manager's vector store.
  #
  # rag-manager runs its own golang-migrate at startup and its first migration
  # opens with `CREATE EXTENSION IF NOT EXISTS vector`, which needs superuser —
  # POSTGRES_USER is the initdb superuser, so connecting as `voipbin` satisfies
  # that. No sandbox-side migration tooling is needed.
  #
  # Deliberately NOT published to the host, unlike db/redis/rabbitmq: those three
  # predate this stack and operators exec/debug against them, whereas postgres is
  # a single-consumer backing store for rag-manager and keeping it unpublished
  # shrinks the surface. For troubleshooting use the docker exec form:
  #   docker exec -it voipbin-postgres psql -U voipbin -d bin_manager
  postgres:
    image: pgvector/pgvector:pg16@sha256:a36250871de0833b8757561c72f2477ef1ddd1101afa4e617fb552e0de514c6b
    container_name: voipbin-postgres
    restart: always
    logging: *default-logging
    environment:
      - POSTGRES_USER=voipbin
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      # Renamed from `rag` to `bin_manager` (2026-08-17) to match the name
      # production's infra-postgresql was renamed to - see
      # monorepo-etc's infra-postgresql/README.md "rag -> bin_manager
      # rename" for the rationale. Only affects a *fresh* postgres init;
      # an existing local `postgres_data` volume with a `rag` database
      # needs the same manual `ALTER DATABASE rag RENAME TO bin_manager;`
      # that README documents, or a `docker compose down -v postgres` +
      # recreate to start clean.
      - POSTGRES_DB=bin_manager
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U voipbin -d bin_manager"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 30s

  # ClickHouse - timeline-manager's analytics backend (its only consumer).
  #
  # timeline-manager runs its own migrations at boot and a migration failure is
  # fatal, so its depends_on gate on this service is required, not cosmetic.
  # Native protocol on 9000 (clickhouse-go/v2); 8123 is the HTTP port used only
  # by the healthcheck here. Not published to the host, same rationale as
  # postgres above.
  clickhouse:
    image: clickhouse/clickhouse-server:24.8@sha256:1ffa82edee000a42c09313bd9f1293d94c570aee74babc1b3ca9983a35fa597b
    container_name: voipbin-clickhouse
    restart: always
    logging: *default-logging
    environment:
      # Without this, the official image's entrypoint writes a users.d override
      # restricting the `default` user to localhost, and timeline-manager's
      # cross-container connection is rejected with code 516 (auth failed) -
      # fatal at its boot-time migration, so it crash-loops. timeline-manager
      # builds its DSN from CLICKHOUSE_ADDRESS alone (no user/password config
      # exists in that service), so a passwordless network-accessible `default`
      # user is the only workable shape. Acceptable here: the port is not
      # published to the host and the service is compose-network-internal,
      # matching the sandbox's existing local-dev credential posture.
      - CLICKHOUSE_SKIP_USER_SETUP=1
    # ClickHouse wants a raised nofile limit; without this it warns loudly and
    # caps its connection handling on hosts with a low default.
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - clickhouse_data:/var/lib/clickhouse
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://127.0.0.1:8123/ping | grep -q Ok"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

  # CoreDNS - Wildcard DNS for *.voipbin.test
  # Resolves all voipbin.test domains to the host IP
  # Also forwards other queries to upstream DNS (8.8.8.8)
  # Note: Corefile is generated by start.sh before container starts
  #
  # DNS is accessible from:
  #   - localhost (127.0.0.1:53) - for local machine via resolv.conf
  #   - LAN (HOST_EXTERNAL_IP:53) - for SIP devices on the network
  coredns:
    image: coredns/coredns:latest
    logging: *default-logging
    container_name: voipbin-dns
    # Internal mode only: .env sets COMPOSE_PROFILES=internal-dns (empty in
    # external mode, where DNS is operator-managed) — dual-mode DNS, VOIP-1275.
    profiles: ["internal-dns"]
    restart: always
    ports:
      # Localhost - for local machine (resolv.conf points here)
      - "127.0.0.1:53:53/udp"
      - "127.0.0.1:53:53/tcp"
      # LAN - for SIP devices on the network
      - "${HOST_EXTERNAL_IP:-0.0.0.0}:53:53/udp"
      - "${HOST_EXTERNAL_IP:-0.0.0.0}:53:53/tcp"
    volumes:
      - ./config/coredns/Corefile:/Corefile:ro
    command: ["-conf", "/Corefile"]

  # Caddy - Web reverse proxy for port-less external URLs (VOIP-1325)
  # External mode only, opt-in: .env sets COMPOSE_PROFILES=web-proxy when
  # init.sh --web-reverse-proxy was used. Terminates TLS with the operator's
  # BYO certificate and routes api/admin/meet/talk by Host header, so those
  # are reachable on the standard 443 port instead of the individual
  # :8443/:3003/:3004/:3005 host ports the default external-mode install uses.
  web-proxy:
    image: caddy:2-alpine
    logging: *default-logging
    container_name: voipbin-web-proxy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    profiles: ["web-proxy"]
    restart: always
    networks:
      - default
    ports:
      # Bound to HOST_EXTERNAL_IP specifically, not 0.0.0.0: external mode
      # gives Kamailio its own dedicated external IP (KAMAILIO_EXTERNAL_IP),
      # which independently binds host ports 80/443 on itself (network_mode:
      # host, e.g. for WSS). A wildcard 0.0.0.0 publish for Caddy collides
      # with that at the kernel bind layer even though the two IPs are
      # different (a wildcard bind conflicts with any existing bind on the
      # same port, specific-address or not) — confirmed live on production.
      # HOST_EXTERNAL_IP is also the address every admin/meet/talk/api DNS
      # record already targets, so this is the semantically correct bind
      # regardless of the conflict.
      - "${HOST_EXTERNAL_IP:-0.0.0.0}:80:80"
      - "${HOST_EXTERNAL_IP:-0.0.0.0}:443:443"
    volumes:
      - ./config/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./certs:/certs:ro
    depends_on:
      - api-manager
      - square-admin
      - square-meet
      - square-talk

  # ===========================================================================
  # SIP Edge Layer (Kamailio + RTPEngine)
  # ===========================================================================

  # RTPEngine - Media proxy for RTP/SRTP handling
  # Uses host network for optimal media performance
  rtpengine:
    image: voipbin/voip-rtpengine@sha256:8b0635b08c4d62651a648a22a1d85b9a44b029599478cb88814eb8ed1005430d
    logging: *default-logging
    restart: unless-stopped
    network_mode: host
    environment:
      - RTPENGINE_INTERFACE_MODE=manual
      # Interface format: pub/<external-ip>;priv/<internal-ip>
      # External: RTPEngine's dedicated external IP for RTP media traffic
      # Internal: RTPEngine's own IP on internal network (setup via scripts/setup-voip-network.sh)
      - RTPENGINE_INTERFACE=pub/${RTPENGINE_EXTERNAL_IP:-127.0.0.1};priv/10.100.0.201
      - RTPENGINE_LISTEN_HTTP=${RTPENGINE_LISTEN_HTTP:-9101}
      - RTPENGINE_LISTEN_NG=${RTPENGINE_LISTEN_NG:-22222}
      - RTPENGINE_LISTEN_CLI=127.0.0.1:2220
      - RTPENGINE_PORT_MIN=${RTPENGINE_PORT_MIN:-20000}
      - RTPENGINE_PORT_MAX=${RTPENGINE_PORT_MAX:-30000}
      - RTPENGINE_TIMEOUT=60
      - RTPENGINE_SILENT_TIMEOUT=3600
      - RTPENGINE_LOG_LEVEL=6
      - RTPENGINE_NUM_THREADS=4
      - RTPENGINE_TOS=184
    volumes:
      - rtpengine-logs:/var/log/rtpengine
      - rtpengine-run:/var/run/rtpengine
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - SYS_NICE
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://127.0.0.1:9101/ping || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  # Kamailio SIP proxy - uses host network for SIP/RTP
  # Config is generated at startup via environment variables
  kamailio:
    image: voipbin/voip-kamailio@sha256:2c6f42f6a9ad5def7dddaab0494ee3e87289a122b8b3d72c534e381d87e8c1ef
    container_name: voipbin-kamailio
    restart: unless-stopped
    network_mode: host
    user: root  # Needed to create /config directory
    volumes:
      - kamailio-logs:/var/log/kamailio
      - ${CERTS_PATH:-./certs}:/certs:ro
    environment:
      # Domain configuration
      - BASE_DOMAIN=${BASE_DOMAIN:-voipbin.test}
      # Network addresses
      # EXTERNAL: Kamailio's dedicated external IP for SIP traffic (different from host IP)
      # INTERNAL: Kamailio's own IP on internal network (setup via scripts/setup-voip-network.sh)
      - KAMAILIO_EXTERNAL_LB_ADDR=${KAMAILIO_EXTERNAL_IP:-127.0.0.1}
      - KAMAILIO_INTERNAL_LB_ADDR=10.100.0.200
      - KAMAILIO_INTERNAL_ADDR=10.100.0.200
      # Database for SIP authentication
      # Kamailio runs on network_mode: host, so it cannot resolve compose
      # service-name DNS (127.0.0.11) and must reach db/redis via a routable
      # host/IP with the port published on the host. Default (127.0.0.1)
      # preserves today's single-node behavior; operators splitting the state
      # layer onto a separate host override KAMAILIO_DB_HOST/KAMAILIO_REDIS_HOST
      # in .env instead of editing compose (Phase 1, address externalization).
      - KAMAILIO_AUTH_DB_URL=mysql://root:${MYSQL_ROOT_PASSWORD}@${KAMAILIO_DB_HOST:-127.0.0.1}:3306/bin_manager
      - KAMAILIO_AUTH_USER_COLUMN=username
      - KAMAILIO_AUTH_DOMAIN_COLUMN=realm
      - KAMAILIO_AUTH_PASSWORD_COLUMN=password
      # Asterisk backends - using internal network with static IPs
      - ASTERISK_CALL_LB_ADDR=10.100.0.210:5060
      - ASTERISK_REGISTRAR_LB_ADDR=10.100.0.211:5060
      - ASTERISK_LISTEN_PORT=5060
      # RTPEngine ng control endpoint (on host network).
      # NOTE: as of the voip-kamailio image built from monorepo-voip commit
      # 3e395a56 (NOJIRA-switch-kamailio-rtpengine-to-udp), the lwsc module
      # and wsapi=lwsc config were removed, so this MUST be a udp:// socket
      # matching rtpengine's RTPENGINE_LISTEN_NG port above, not ws://.
      - RTPENGINE_SOCKS=udp:127.0.0.1:22222
      # Monitoring
      - HOMER_URI=${HOMER_URI:-sip:127.0.0.1:9060}
      # Redis for cache (exposed on host port 6379). See KAMAILIO_DB_HOST note above.
      - REDIS_CACHE_ADDRESS=${KAMAILIO_REDIS_HOST:-127.0.0.1}
      # PSTN whitelist - defaults to host IP so local PSTN-style calls work
      - PSTN_WHITELIST_IPS=${PSTN_WHITELIST_IPS:-${HOST_EXTERNAL_IP:-127.0.0.1}}
    depends_on:
      rtpengine:
        condition: service_healthy
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "/usr/bin/pgrep", "kamailio"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging: *default-logging

  # ===========================================================================
  # Asterisk Media Servers
  # ===========================================================================

  # Asterisk Call Server - handles call routing and media
  asterisk-call:
    image: voipbin/voip-asterisk-call@sha256:ac6d57398fdbf1b9243b4def8ea22952ed55445f91365aee0d9cf985b94b6232
    logging: *default-logging
    container_name: voipbin-ast-call
    restart: unless-stopped
    hostname: voipbin-ast-call
    command: /k8s_start.sh
    networks:
      default:
        ipv4_address: 10.100.0.210
    environment:
      # Kamailio outbound proxy address for routing calls through SIP proxy
      # Use Kamailio's IP on the internal network (setup via scripts/setup-voip-network.sh)
      - KAMAILIO_INTERNAL_LB_ADDRESS=10.100.0.200
    healthcheck:
      test: ["CMD", "asterisk", "-rx", "core show help"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    volumes:
      - asterisk-call-recording:/var/spool/asterisk/recording
    ports:
      # RTP ports for direct media (when not using RTPEngine)
      - "10000-10050:10000-10050/udp"
    depends_on:
      db:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    extra_hosts:
      - "host.docker.internal:host-gateway"

  # Asterisk-to-RabbitMQ proxy (ARI/AMI bridge) for Call server
  #
  # IMPORTANT (VOIP-1237): network_mode: "service:asterisk-call" attaches this
  # container to asterisk-call's kernel network namespace ONCE, at this
  # container's own start time. It is NOT re-resolved dynamically. If
  # asterisk-call is restarted alone (docker compose restart asterisk-call /
  # docker restart), Docker gives it a brand-new namespace, but this proxy
  # stays bound to the OLD, now-orphaned one — localhost:8088 (ARI) then
  # resolves to nothing and the proxy never recovers on its own. Always
  # restart this service TOGETHER with asterisk-call (see scripts/voipbin-cli.py
  # cmd_restart, which enforces this pairing automatically). Never restart
  # asterisk-call in isolation.
  asterisk-call-proxy:
    image: voipbin/voip-asterisk-proxy@sha256:1f30231fb4bc52a475f74d6996b7e03d03d9e44ec87f36ebbf05d88079436cf5
    logging: *default-logging
    restart: unless-stopped
    network_mode: "service:asterisk-call"
    command: ./asterisk-proxy
    depends_on:
      asterisk-call:
        condition: service_healthy
    environment:
      - TARGET_SERVICE=call
      - AMI_EVENT_FILTER=
      - AMI_HOST=127.0.0.1
      - AMI_PASSWORD=${AMI_PASSWORD}
      - AMI_PORT=5038
      - AMI_USERNAME=${AMI_USERNAME}
      - ARI_ACCOUNT=${AMI_USERNAME}:${AMI_PASSWORD}
      - ARI_ADDRESS=localhost:8088
      - ARI_APPLICATION=voipbin
      - ARI_SUBSCRIBE_ALL=true
      - ASTERISK_ID=${ASTERISK_CALL_ID:-voipbin-ast-call}
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2113
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - RABBITMQ_QUEUE_LISTEN=asterisk.call.request
      - RECORDING_ASTERISK_DIRECTORY=/var/spool/asterisk/recording
      - RECORDING_BUCKET_DIRECTORY=recording
      - RECORDING_BUCKET_NAME=${GCP_BUCKET_NAME_MEDIA:-voipbin-voip-media-bucket}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - REDIS_PASSWORD=
      - KUBERNETES_DISABLED=true
    volumes:
      - asterisk-call-recording:/var/spool/asterisk/recording

  # Asterisk Conference Server - handles conference/confbridge calls
  asterisk-conference:
    image: voipbin/voip-asterisk-conference@sha256:250881ae43e93238a4c66774bf7cbc7daea364c7d7ab5899c31a128fa344cc0e
    logging: *default-logging
    restart: unless-stopped
    hostname: voipbin-ast-conf
    command: /k8s_start.sh
    networks:
      default:
        ipv4_address: 10.100.0.212
    healthcheck:
      test: ["CMD", "asterisk", "-rx", "core show help"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    volumes:
      - asterisk-conf-recording:/var/spool/asterisk/recording
    ports:
      # RTP ports for conference media
      - "10100-10150:10100-10150/udp"
    depends_on:
      db:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    extra_hosts:
      - "host.docker.internal:host-gateway"

  # Asterisk-to-RabbitMQ proxy (ARI/AMI bridge) for Conference server
  # IMPORTANT (VOIP-1237): shares asterisk-conference's network namespace via
  # network_mode: "service:". See the identical note on asterisk-call-proxy
  # above — always restart together with asterisk-conference, never alone.
  asterisk-conference-proxy:
    image: voipbin/voip-asterisk-proxy@sha256:1f30231fb4bc52a475f74d6996b7e03d03d9e44ec87f36ebbf05d88079436cf5
    logging: *default-logging
    restart: unless-stopped
    network_mode: "service:asterisk-conference"
    command: ./asterisk-proxy
    depends_on:
      asterisk-conference:
        condition: service_healthy
    environment:
      - TARGET_SERVICE=conference
      - AMI_EVENT_FILTER=
      - AMI_HOST=127.0.0.1
      - AMI_PASSWORD=${AMI_PASSWORD}
      - AMI_PORT=5038
      - AMI_USERNAME=${AMI_USERNAME}
      - ARI_ACCOUNT=${AMI_USERNAME}:${AMI_PASSWORD}
      - ARI_ADDRESS=localhost:8088
      - ARI_APPLICATION=voipbin
      - ARI_SUBSCRIBE_ALL=true
      - ASTERISK_ID=${ASTERISK_CONF_ID:-voipbin-ast-conf}
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2113
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - RABBITMQ_QUEUE_LISTEN=asterisk.conference.request
      - RECORDING_ASTERISK_DIRECTORY=/var/spool/asterisk/recording
      - RECORDING_BUCKET_DIRECTORY=recording
      - RECORDING_BUCKET_NAME=${GCP_BUCKET_NAME_MEDIA:-voipbin-voip-media-bucket}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - REDIS_PASSWORD=
      - KUBERNETES_DISABLED=true
    volumes:
      - asterisk-conf-recording:/var/spool/asterisk/recording

  # Asterisk Registrar Server - handles SIP registration for extensions
  asterisk-registrar:
    image: voipbin/voip-asterisk-registrar@sha256:8ca9db325b34bc03b5365f9a2492f7163ca2383802856b4af1f0fc5b7f7b6d71
    logging: *default-logging
    container_name: voipbin-ast-registrar
    restart: unless-stopped
    hostname: voipbin-ast-registrar
    command: /start.sh
    networks:
      default:
        ipv4_address: 10.100.0.211
    environment:
      - DATABASE_ASTERISK_HOST=${DB_HOST:-db}
      - DATABASE_ASTERISK_PORT=3306
      - DATABASE_ASTERISK_DATABASE=asterisk
      - DATABASE_ASTERISK_USERNAME=${DATABASE_ASTERISK_USERNAME:-root}
      - DATABASE_ASTERISK_PASSWORD=${DATABASE_ASTERISK_PASSWORD:-${MYSQL_ROOT_PASSWORD}}
    healthcheck:
      test: ["CMD", "asterisk", "-rx", "core show help"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    ports:
      # RTP ports for registrar media
      - "10200-10250:10200-10250/udp"
    depends_on:
      db:
        condition: service_healthy
    extra_hosts:
      - "host.docker.internal:host-gateway"

  # Asterisk-to-RabbitMQ proxy (ARI/AMI bridge) for Registrar server
  # IMPORTANT (VOIP-1237): shares asterisk-registrar's network namespace via
  # network_mode: "service:". See the identical note on asterisk-call-proxy
  # above — always restart together with asterisk-registrar, never alone.
  asterisk-registrar-proxy:
    image: voipbin/voip-asterisk-proxy@sha256:1f30231fb4bc52a475f74d6996b7e03d03d9e44ec87f36ebbf05d88079436cf5
    logging: *default-logging
    restart: unless-stopped
    network_mode: "service:asterisk-registrar"
    command: ./asterisk-proxy
    depends_on:
      asterisk-registrar:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - TARGET_SERVICE=registrar
      - AMI_EVENT_FILTER=
      - AMI_HOST=127.0.0.1
      - AMI_PASSWORD=${AMI_PASSWORD}
      - AMI_PORT=5038
      - AMI_USERNAME=${AMI_USERNAME}
      - ARI_ACCOUNT=${AMI_USERNAME}:${AMI_PASSWORD}
      - ARI_ADDRESS=localhost:8088
      - ARI_APPLICATION=voipbin
      - ARI_SUBSCRIBE_ALL=true
      - ASTERISK_ID=${ASTERISK_REGISTRAR_ID:-voipbin-ast-registrar}
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2113
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - RABBITMQ_QUEUE_LISTEN=asterisk.registrar.request
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - REDIS_PASSWORD=
      - KUBERNETES_DISABLED=true

  # ===========================================================================
  # Backend Manager Services
  # ===========================================================================

  agent-manager:
    image: voipbin/bin-agent-manager@sha256:e774735ad4f4fd8ecae9c3f831845ad0826d419b59bfa186a34bdfeda4790c34
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-agent-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./agent-manager

  ai-manager:
