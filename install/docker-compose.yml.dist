      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./route-manager

  schedule-manager:
    image: voipbin/bin-schedule-manager@sha256:2c4674d32dd956bc2ee12f53695784819481c92297622bd197eefd9c6616b96c
    logging: *default-logging
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-schedule-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      # In-stack scheduled DB backup (VOIP-1281): a narrower, mariadb-dump-only
      # complement to `voipbin backup`'s full manual snapshot (which also
      # captures recording volumes, config/, and a manifest.json). Deliberately
      # a separate subdirectory under backups/ so the two never collide or get
      # pruned by each other's retention count. See README.md "Scheduled Jobs".
      - SCHEDULE_BACKUP_DIR=/backups
      - SCHEDULE_BACKUP_RETENTION_COUNT=7
    volumes:
      - ${SCHEDULE_BACKUP_HOST_DIR:-./backups/scheduled-db}:/backups
    command: ./schedule-manager

  # sentinel-manager is intentionally NOT run here: it requires the
  # Kubernetes API (rest.InClusterConfig) and crash-loops in compose.
  # Its role (watching Asterisk pods to trigger call recovery) is a
  # planned docker-events bridge; see docs/plans/2026-07-04-single-
  # server-production-mode-design.md section 3.6.

  storage-manager:
    image: voipbin/bin-storage-manager@sha256:0432a09831630c03c6d8021c7e30eb5308cd7802898edc1093434a9c4605dc2f
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-storage-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      - GCP_PROJECT_ID=${GCP_PROJECT_ID:-}
      - GCP_BUCKET_NAME_TMP=${GCP_BUCKET_NAME_TMP:-}
      - GCP_BUCKET_NAME_MEDIA=${GCP_BUCKET_NAME_MEDIA:-}
      - JWT_KEY=${JWT_KEY:-${STORAGE_JWT_KEY:-}}
      # storage-manager makes a missing GOOGLE_APPLICATION_CREDENTIALS fatal at
      # boot (monorepo 1f9002953 removed the workload-identity fallback), so the
      # credential env line AND the mount are both required for it to start here.
      # The dummy key satisfies google.JWTConfigFromJSON (which only unmarshals
      # and checks type == service_account); it does NOT satisfy actual signing,
      # so signed download URLs and file Create stay non-functional until a real
      # service-account key is supplied.
      - GOOGLE_APPLICATION_CREDENTIALS=/tmp/google_service_account.json
    volumes:
      - ${GOOGLE_APPLICATION_CREDENTIALS:-./config/dummy-gcp-credentials.json}:/tmp/google_service_account.json:ro
    command: ./storage-manager

  tag-manager:
    image: voipbin/bin-tag-manager@sha256:1b7cb7cb5dab7afa4161e7593fb5236d2eab3a9f8d135d060bd1f32c1137cfaa
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-tag-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./tag-manager

  talk-manager:
    image: voipbin/bin-talk-manager@sha256:06d309e002a6c55271c13432f9450672ba88d582010f209bcf0aa39710ed6c67
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-talk-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./talk-manager

  timeline-manager:
    image: voipbin/bin-timeline-manager@sha256:3111de692c2f86dcfac34c73636e5cc59fb3fb61ecdbdd4211d501e83bf5accb
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: always
    # The clickhouse gate is REQUIRED, not cosmetic: with CLICKHOUSE_ADDRESS set,
    # timeline-manager always runs its migrations at boot and a migration failure
    # is fatal (os.Exit(1)). Racing ClickHouse to readiness would make it exit
    # non-zero on every fresh `up` and only recover via restart: always.
    depends_on:
      rabbitmq:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
    environment:
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      # 9000 is ClickHouse's native protocol port (clickhouse-go/v2), not HTTP.
      - CLICKHOUSE_ADDRESS=${CLICKHOUSE_ADDRESS:-clickhouse:9000}
      - CLICKHOUSE_DATABASE=${CLICKHOUSE_DATABASE:-default}
      - HOMER_API_ADDRESS=${HOMER_API_ADDRESS:-}
      - HOMER_AUTH_TOKEN=${HOMER_AUTH_TOKEN:-}
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./timeline-manager

  transcribe-manager:
    image: voipbin/bin-transcribe-manager@sha256:00f6505e411448a0b22abd4bc9ca9919beb396fb1c9f80eb892f4769b7642982
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      - AWS_ACCESS_KEY=${AWS_ACCESS_KEY:-}
      - AWS_SECRET_KEY=${AWS_SECRET_KEY:-}
      - POD_IP=${POD_IP:-127.0.0.1}
      - GOOGLE_APPLICATION_CREDENTIALS=/tmp/google_service_account.json
    command: ./transcribe-manager
    volumes:
      - ${GOOGLE_APPLICATION_CREDENTIALS:-./config/dummy-gcp-credentials.json}:/tmp/google_service_account.json:ro

  transfer-manager:
    image: voipbin/bin-transfer-manager@sha256:5aefc0f3ef8466e743642e67bed4c9a14f54f3f6cad03541478c9bed117641b4
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-transfer-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./transfer-manager

  tts-manager:
    image: voipbin/bin-tts-manager@sha256:c5a3368807b24e9f211bfce142d733539c9f36606a4b4336564df05f417a0260
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-tts-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      - AWS_ACCESS_KEY=${AWS_ACCESS_KEY:-}
      - AWS_SECRET_KEY=${AWS_SECRET_KEY:-}
      - ELEVENLABS_API_KEY=${ELEVENLABS_API_KEY:-}
      # tts-manager makes a missing GOOGLE_APPLICATION_CREDENTIALS fatal at
      # boot (same google.JWTConfigFromJSON check as storage-manager above),
      # so the credential env line AND the mount are both required for it to
      # start here. The dummy key satisfies google.JWTConfigFromJSON (which
      # only unmarshals and checks type == service_account); it does NOT
      # satisfy actual signing, so real GCP Cloud TTS calls stay non-functional
      # (falling back to AWS Polly, if configured) until a real service-account
      # key is supplied.
      - GOOGLE_APPLICATION_CREDENTIALS=/tmp/google_service_account.json
      # Batch-TTS media delivery: the Go service writes generated wav files to
      # the shared-data volume; the tts-manager-http sidecar below serves them
      # over plain HTTP for Asterisk to fetch. POD_IP is a literal (not a
      # ${VAR:-default}) because it must always be the sidecar's compose
      # service name, never operator-overridable. NOTE: unlike POD_IP on
      # transcribe-manager (defaults to 127.0.0.1, its own loopback) and
      # pipecat-manager (defaults to its own compose service name), here it
      # names a *different* service - the tts-manager-http sidecar, not
      # tts-manager itself. Same env var name, three different meanings; do
      # not assume "my own address" when touching this elsewhere in the file.
      - POD_IP=tts-manager-http
    volumes:
      - ${GOOGLE_APPLICATION_CREDENTIALS:-./config/dummy-gcp-credentials.json}:/tmp/google_service_account.json:ro
      - shared-data:/shared-data
    command: ./tts-manager

  # Media http sidecar: serves the batch-TTS wav files tts-manager writes into
  # /shared-data. Same image and command as the upstream http-server sidecar.
  # bin-tts-manager: "Do not serve files directly from the Go service."
  # Accepted risk (same posture as AMI/ARI on 0.0.0.0 in CLAUDE.md's AMI/ARI
  # note): python -m http.server has no auth and lists directories by
  # default. No ports: are published here, so it's reachable only from other
  # containers on the compose network, not the host's external interface -
  # consistent with this file's existing internal-only trust boundary for
  # inter-service traffic (e.g. postgres/clickhouse are equally unauthenticated
  # and unpublished). Do not add a `ports:` mapping to this service.
  tts-manager-http:
    image: python:3.9-bookworm
    logging: *default-logging
    restart: always
    volumes:
      - shared-data:/shared-data
    command: ["sh", "-c", "python3 -m http.server 80 -d /shared-data"]

  # webchat-manager: pure RabbitMQ-RPC + MySQL + Redis service. The user-facing
  # webchat websocket lives in api-manager, not here, so no port is published and
  # no container_name is pinned (it ships no CLI for ops scripts to exec into).
  # Its widgets carry a direct_hash column, so it depends on direct-manager's
  # schema (supplied by the dbscheme pin) rather than on the container.
  webchat-manager:
    image: voipbin/bin-webchat-manager@sha256:c661ad0fbd6509a793778726f1632b23a142e536d88e6fb4e8f59440eabefe76
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./webchat-manager

  webhook-manager:
    image: voipbin/bin-webhook-manager@sha256:79842a996976518a89ecb7e11d8225c77809a92db9a1fadf551e4fff0ae8fb58
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-webhook-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./webhook-manager

  # ===========================================================================
  # Frontend
  # ===========================================================================
  # Web services share HOST_IP with different ports (Docker port mapping):
  #   - https://api.voipbin.test:8443   -> HOST_IP:8443
  #   - http://admin.voipbin.test:3003  -> HOST_IP:3003
  #   - http://meet.voipbin.test:3004   -> HOST_IP:3004
  #   - http://talk.voipbin.test:3005   -> HOST_IP:3005
  # SIP domains (sip.voipbin.test, etc.) resolve to KAMAILIO_EXTERNAL_IP.
  #
  # NOTE: If using self-signed certificates, you must accept the API certificate first:
  #   1. Visit https://api.voipbin.test:8443 in your browser
  #   2. Accept the certificate warning ("Proceed to api.voipbin.test")
  #   3. Then access admin/meet/talk - otherwise you'll get ERR_CERT_AUTHORITY_INVALID
  # To avoid this, install mkcert: mkcert -install && rm -rf certs/ && ./scripts/init.sh

  square-admin:
    image: voipbin/square-admin@sha256:67b3d0378f74c545160e7908a1a1f1980c92b953ee542dd3a0e2fc23ede63fb5
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:80/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    hostname: voipbin-admin-host
    restart: always
    networks:
      - default
    ports:
      # SQUARE_BIND_ADDR: 0.0.0.0 by default; init.sh sets it to 127.0.0.1
      # when --web-reverse-proxy is active (VOIP-1325), since that flag's
      # whole point is putting Caddy's TLS-terminated 443 in front of this
      # plaintext-HTTP port instead of exposing it directly.
      - "${SQUARE_BIND_ADDR:-0.0.0.0}:3003:80"
    depends_on:
      - api-manager
    environment:
      # Base hostname (used as fallback if per-service URLs not set)
      - REACT_APP_BASE_HOSTNAME=${BASE_HOSTNAME:-voipbin.test}
      # Per-service URL overrides for local development
      - REACT_APP_API_URL=${API_URL:-https://api.voipbin.test:8443/}
      - REACT_APP_WEBSOCKET_URL=${WEBSOCKET_URL:-wss://api.voipbin.test:8443/v1.0/ws}
      - REACT_APP_REGISTRAR_DOMAIN=${REGISTRAR_DOMAIN:-registrar.voipbin.test}

  square-meet:
    image: voipbin/square-meet@sha256:395a410f8d889f0200b0198752489cde565598dcb28fdddad6ec18642db23309
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:80/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    hostname: voipbin-meet-host
    restart: always
    networks:
      - default
    ports:
      - "${SQUARE_BIND_ADDR:-0.0.0.0}:3004:80"
    depends_on:
      - api-manager
    environment:
      # Base hostname (used as fallback if per-service URLs not set)
      - REACT_APP_BASE_HOSTNAME=${BASE_HOSTNAME:-voipbin.test}
      # Per-service URL overrides for conference
      - REACT_APP_CONFERENCE_URL=${CONFERENCE_URL:-wss://conference.voipbin.test}
      - REACT_APP_CONFERENCE_DOMAIN=${CONFERENCE_DOMAIN:-conference.voipbin.test}

  square-talk:
    image: voipbin/square-talk@sha256:36d28fbf1e0fff176ed122d2fd0632294a74766c4c1c1b7d3f5cab8be16c6eed
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:80/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    container_name: voipbin-talk
    hostname: voipbin-talk-host
    restart: always
    networks:
      - default
    ports:
      - "${SQUARE_BIND_ADDR:-0.0.0.0}:3005:80"
    depends_on:
      - api-manager
    environment:
      # Base hostname (used as fallback if per-service URLs not set)
      - REACT_APP_BASE_HOSTNAME=${BASE_HOSTNAME:-voipbin.test}
      # Per-service URL overrides for talk
      - REACT_APP_API_URL=${API_URL:-https://api.voipbin.test:8443/}
      - REACT_APP_WEBSOCKET_URL=${WEBSOCKET_URL:-wss://api.voipbin.test:8443/v1.0/ws}
      - REACT_APP_REGISTRAR_URL=${REGISTRAR_URL:-wss://sip.voipbin.test:5066}
      - REACT_APP_REGISTRAR_DOMAIN=${REGISTRAR_DOMAIN:-registrar.voipbin.test}

volumes:
  redis_data:
  rabbitmq_data:
  db_data:
  postgres_data:
  clickhouse_data:
  asterisk-call-recording:
  asterisk-conf-recording:
  kamailio-logs:
  rtpengine-logs:
  rtpengine-run:
  shared-data:

# Default network for services that don't use host mode
networks:
  default:
    driver: bridge
    ipam:
      config:
        - subnet: 10.100.0.0/16
