  # direct-manager: pure RabbitMQ-RPC + MySQL + Redis service, no HTTP listener.
  # agent-manager RPCs bin-manager.direct-manager.request during agent creation,
  # so without this the admin-agent bootstrap (setup_test_customer.sh) times out.
  # container_name is pinned because the image ships a direct-control CLI that
  # ops scripts docker-exec into, same precedent as voipbin-customer-mgr.
  direct-manager:
    image: voipbin/bin-direct-manager@sha256:3875c158aed2cdabad7feaf0103f23acbe088cf3dda28c45a84bc32422e28b2e
