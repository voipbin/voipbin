    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./outdial-manager

  pipecat-manager:
    image: voipbin/bin-pipecat-manager@sha256:0c323f32ef67a3b48a6ed0799649b123e02999ef7edfe2a47e7cf4c2eeb802aa
    logging: *default-logging
    healthcheck:
      # python image (Debian trixie) ships NEITHER wget nor curl - use python3.
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:2112/metrics', timeout=4)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      - CARTESIA_API_KEY=${CARTESIA_API_KEY:-}
      - ELEVENLABS_API_KEY=${ELEVENLABS_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - DEEPGRAM_API_KEY=${DEEPGRAM_API_KEY:-}
      - XAI_API_KEY=${XAI_API_KEY:-}
      - POD_IP=${POD_IP:-pipecat-manager}
    command: ./pipecat-manager

  # pipecat-script-runner: the Python Pipecat pipeline sidecar (FastAPI/uvicorn
  # on 0.0.0.0:8000) pipecat-manager drives via http://localhost:8000/run. Same
  # image as pipecat-manager (all Python deps are baked in already).
  # IMPORTANT (VOIP-1237-style orphan hazard): shares pipecat-manager's network
  # namespace via network_mode: "service:". If pipecat-manager is restarted
  # alone (docker compose restart pipecat-manager / docker restart), Docker
  # gives it a brand-new namespace but this sidecar stays bound to the OLD, now
  # -orphaned one - localhost:8000 then resolves to nothing and every ai_talk
  # action fails with "connection refused" until this sidecar is restarted too.
  # Always restart together with pipecat-manager (see scripts/voipbin-cli.py's
  # SIDECAR_PAIRS, which enforces this pairing automatically). Never restart
  # pipecat-manager in isolation.
  pipecat-script-runner:
    image: voipbin/bin-pipecat-manager@sha256:0c323f32ef67a3b48a6ed0799649b123e02999ef7edfe2a47e7cf4c2eeb802aa
    logging: *default-logging
    restart: always
    network_mode: "service:pipecat-manager"
    depends_on:
      pipecat-manager:
        condition: service_healthy
    # Same env set the GKE pipecat-script-runner container received - the
    # Python side calls the STT/LLM/TTS APIs directly. GOOGLE_API_KEY and
    # OPENROUTER_API_KEY are intentionally only read here: the Go side
    # (pipecat-manager above) never consumes them.
    environment:
      - CARTESIA_API_KEY=${CARTESIA_API_KEY:-}
      - ELEVENLABS_API_KEY=${ELEVENLABS_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - DEEPGRAM_API_KEY=${DEEPGRAM_API_KEY:-}
      - XAI_API_KEY=${XAI_API_KEY:-}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
      - OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
    command: ["python", "/app/scripts/pipecat/main.py"]

  queue-manager:
    image: voipbin/bin-queue-manager@sha256:9502ec0b07737856b4ecc939357e0e1dfb6f60419f1413e6e925b3f0ed5fdbd8
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-queue-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
    command: ./queue-manager

  rag-manager:
    image: voipbin/bin-rag-manager@sha256:19bc23b8dc207e17a54c396221ae708ad782444b2cb64338c43bac7fc267bd14
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: always
    depends_on:
      rabbitmq:
        condition: service_healthy
      postgres:
        condition: service_healthy
    # rag-manager was re-founded upstream: OpenAI embeddings + GCS .gob blobs ->
    # Vertex AI embeddings + PostgreSQL/pgvector. Its Validate() hard-fails at
    # boot on an empty RABBITMQ_ADDRESS, GCP_PROJECT_ID, GCP_REGION or
    # POSTGRESQL_DSN, which is why init.sh writes non-empty placeholders for the
    # GCP trio AND all three carry non-empty compose fallbacks below: an
    # existing install upgrading via `voipbin update all` keeps its old .env
    # (which has GCP_PROJECT_ID= / GCP_BUCKET_NAME_MEDIA= as empty strings and
    # no GCP_REGION at all), and compose's :- operator substitutes the fallback
    # for empty-or-unset either way. These fallbacks are scoped to this service
    # block only - other consumers of the same vars keep their own semantics.
    # Boot vs. function: with placeholder project/region/bucket and the
    # dummy credential the service starts, but actual ingestion/query calls fail
    # at Vertex AI / GCS until a real GCP project and service-account key are
    # supplied.
    environment:
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - GCP_PROJECT_ID=${GCP_PROJECT_ID:-sandbox-placeholder}
      - GCP_REGION=${GCP_REGION:-us-central1}
      - GCP_BUCKET_NAME_MEDIA=${GCP_BUCKET_NAME_MEDIA:-sandbox-placeholder-media}
      - POSTGRESQL_DSN=postgres://voipbin:${POSTGRES_PASSWORD}@postgres:5432/bin_manager?sslmode=disable
      - RAG_TOP_K=${RAG_TOP_K:-5}
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      - GOOGLE_APPLICATION_CREDENTIALS=/tmp/google_service_account.json
    volumes:
      - ${GOOGLE_APPLICATION_CREDENTIALS:-./config/dummy-gcp-credentials.json}:/tmp/google_service_account.json:ro
    command: ./rag-manager

  registrar-manager:
    image: voipbin/bin-registrar-manager@sha256:dff35ba4b4ee08734fa1ce34e8edb651563a4d038e391e75a2c05891b3cdc77a
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-registrar-mgr
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    environment:
      - DATABASE_DSN_BIN=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/bin_manager
      - DATABASE_DSN_ASTERISK=root:${MYSQL_ROOT_PASSWORD}@tcp(${DB_HOST:-db}:${DB_PORT:-3306})/asterisk
      - RABBITMQ_ADDRESS=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST:-rabbitmq}:${RABBITMQ_PORT:-5672}
      - REDIS_ADDRESS=${REDIS_HOST:-redis}:${REDIS_PORT:-6379}
      - REDIS_DATABASE=1
      - PROMETHEUS_ENDPOINT=/metrics
      - PROMETHEUS_LISTEN_ADDRESS=:2112
      - DOMAIN_NAME_EXTENSION=${DOMAIN_NAME_EXTENSION:-registrar.voipbin.test}
      - DOMAIN_NAME_TRUNK=${DOMAIN_NAME_TRUNK:-trunk.voipbin.test}
      - DOMAIN_SHORT_LABEL_ENABLED=${DOMAIN_SHORT_LABEL_ENABLED:-false}
    command: ./registrar-manager

  route-manager:
    image: voipbin/bin-route-manager@sha256:44e5b8e44e99ac8ba4c7bdd12b7b0a154f526a0f2d53ec8182c71313d35bd7f9
    logging: *default-logging
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2112/metrics"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    container_name: voipbin-route-mgr
    restart: always
    depends_on:
