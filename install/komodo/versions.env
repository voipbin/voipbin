# Pinned Komodo release used by scripts/komodo-setup.sh.
#
# Plain KEY=value lines (no quotes, no spaces, no shell expansion). The file is
# read by bash, python and docker compose with the same meaning. It is kept
# apart from versions.lock on purpose: the update cadence and the verification
# are different. To change a pin, edit this one file and run
# `sudo ./voipbin komodo setup`, which converges the host to these values.
#
# periphery binary URL (derived):
#   https://github.com/moghtech/komodo/releases/download/${KOMODO_VERSION}/periphery-x86_64
KOMODO_VERSION=v2.3.4
# sha256 of the periphery-x86_64 asset for KOMODO_VERSION (release assets carry no checksum file)
KOMODO_PERIPHERY_SHA256=46d50313970aea59d293bbe237648f4becea74e8abc2f30f1bb62b73456fc72e
# Images are pinned by digest, a tag alone is never accepted.
KOMODO_CORE_IMAGE=ghcr.io/moghtech/komodo-core@sha256:91b2afd7b3bb2abea0ebd3046d65ec457eb1f3d505868d1d60cb0f8562490ef9
KOMODO_MONGO_IMAGE=mongo@sha256:b0c835c26e5997413e985000f1013c275377cd9607761c1784d486f6dd620b7f
