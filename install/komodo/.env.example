# Shape of komodo/.env (mode 600, generated by scripts/komodo-setup.sh with
# random values the first time it runs; never committed). Do not copy this file
# over a real .env: the mongo credentials only take effect when the mongo data
# volume is first initialized.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=<random>
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=<random, same value as komodo/admin-password>
KOMODO_JWT_SECRET=<random>
KOMODO_WEBHOOK_SECRET=<random>
