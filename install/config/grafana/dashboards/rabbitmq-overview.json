{
  "uid": "voipbin-rabbitmq",
  "title": "VoIPBin - RabbitMQ Overview",
  "description": "Queue depth, message rates, and connections via RabbitMQ's built-in rabbitmq_prometheus plugin (VOIP-1336).",
  "tags": ["voipbin", "rabbitmq"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Ready Messages (all queues)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "legendFormat": "ready",
          "refId": "A"
        },
        {
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "unacked",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Publish / Deliver Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_channel_messages_published_total[5m]))",
          "legendFormat": "published/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rabbitmq_channel_messages_delivered_total[5m]))",
          "legendFormat": "delivered/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Open Connections",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rabbitmq_connections)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Open Channels",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rabbitmq_channels)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Consumers",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rabbitmq_queue_consumers)", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Node Memory Used",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "rabbitmq_process_resident_memory_bytes", "refId": "A" }
      ]
    }
  ]
}
