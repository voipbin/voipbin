# ==============================================================================
# VoIPBin Sandbox - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values appropriately.
# Variables marked with (REQUIRED) must be set for the system to work.
# Variables marked with (OPTIONAL) have sensible defaults.
# ==============================================================================

# ==============================================================================
# Google Cloud Platform (REQUIRED for TTS, storage, and AI features)
# ==============================================================================
# The values init.sh generates are non-empty placeholders, not real GCP config:
# they satisfy config validation without granting GCP access. rag-manager's
# Validate() hard-fails at boot on an empty GCP_PROJECT_ID or GCP_REGION, before
# any GCP client is constructed, so an empty value is a crash loop rather than a
# degraded service.
#
# Consequence worth knowing: rag-manager RUNS with the placeholders, but actual
# RAG ingestion/query needs a real GCP project plus a service-account key —
# embedding calls fail at Vertex AI / GCS until you replace these.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google_service_account.json
GCP_PROJECT_ID=sandbox-placeholder
GCP_REGION=us-central1
GCP_BUCKET_NAME_TMP=your-gcp-bucket-name-tmp
GCP_BUCKET_NAME_MEDIA=sandbox-placeholder-media

# ==============================================================================
# API SSL Certificates (REQUIRED for HTTPS API access)
# ==============================================================================
# Base64-encoded SSL certificate and private key for the API manager
# Generate with: cat cert.pem | base64 -w0
API_SSL_CERT_BASE64=
API_SSL_PRIVKEY_BASE64=

# Base64-encoded SSL certificate and private key for webhook/hook manager
HOOK_SSL_CERT_BASE64=
HOOK_SSL_PRIVKEY_BASE64=

# ==============================================================================
# Install Mode (written by init.sh - dual-mode DNS, VOIP-1275)
# ==============================================================================
# DOMAIN_MODE: internal (default; CoreDNS serves *.voipbin.test with the
# resolv.conf forwarding) or external (operator-managed DNS on a real domain).
# Set by init.sh --mode; an absent key is treated as internal (legacy .env).
DOMAIN_MODE=internal

# COMPOSE_PROFILES: docker compose profile set read from this file.
# internal-dns enables the coredns service in internal mode; external mode
# writes the key with an empty value (the key is always present so a stale
# pre-dual-mode .env is detectable).
COMPOSE_PROFILES=internal-dns

# TLS_MODE: mkcert | selfsigned | byo. Set by init.sh (--tls). byo certs are
# installed/renewed via install-certs.sh and never auto-regenerated.
TLS_MODE=mkcert

# ==============================================================================
# SIP/VoIP Network Configuration (OPTIONAL - defaults work for local dev)
# ==============================================================================
# Base domain for SIP routing (default: voipbin.test)
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
BASE_DOMAIN=voipbin.test

# Host's external IP (your LAN IP, auto-detected by init.sh)
HOST_EXTERNAL_IP=127.0.0.1

# Kamailio's dedicated external IP (MUST differ from HOST_EXTERNAL_IP to avoid SIP loop detection)
# Auto-generated by init.sh - finds an available IP in your subnet
KAMAILIO_EXTERNAL_IP=127.0.0.1

# RTPEngine's dedicated external IP for RTP media traffic
# Auto-generated by init.sh - finds an available IP in your subnet
RTPENGINE_EXTERNAL_IP=127.0.0.1

# Internal addresses for host-mode services (Kamailio, RTPEngine)
# These require running: sudo ./scripts/setup-voip-network.sh
# The script creates macvlan interfaces so host-mode services can bind to internal IPs:
#   - Kamailio:  10.100.0.200
#   - RTPEngine: 10.100.0.201
# These IPs are hardcoded in docker-compose.yml

# Kamailio runs on network_mode: host and therefore cannot resolve compose
# service-name DNS. Defaults below preserve today's single-node behavior
# (db/redis reachable via the host's published ports). Override these only
# if you are splitting the state layer (db/redis) onto a separate host —
# point them at that host's routable address instead (Phase 1, address
# externalization; see docs/plans/2026-07-05-production-grade-horizontal-scale-design.md).
KAMAILIO_DB_HOST=127.0.0.1   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
KAMAILIO_REDIS_HOST=127.0.0.1   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.

# State-layer address externalization (Phase 1, address externalization).
# All 26 bin-* application services default to compose service-name DNS
# (db/redis/rabbitmq), which is correct and unchanged for today's single-node
# default. Override these ONLY if you split MySQL/Redis/RabbitMQ onto a
# separate host from the app services later — point at that host's
# routable address + published port instead. Leave unset for single-node.
DB_HOST=db   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
DB_PORT=3306   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
REDIS_HOST=redis   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
REDIS_PORT=6379   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
RABBITMQ_HOST=rabbitmq   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
RABBITMQ_PORT=5672   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.

# RTPEngine configuration
# RTPENGINE_INTERFACE is currently ignored — docker-compose.yml hardcodes this
# from RTPENGINE_EXTERNAL_IP (pub/${RTPENGINE_EXTERNAL_IP};priv/10.100.0.201),
# so setting it here has no effect. Kept for visibility, not overridable.
RTPENGINE_INTERFACE=any
RTPENGINE_PORT_MIN=20000   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
RTPENGINE_PORT_MAX=30000   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.
RTPENGINE_LISTEN_HTTP=9101   # compose default is used unless you override this — see Track A externalization, docs/plans/2026-07-05-production-grade-horizontal-scale-design.md, for the multi-host case.

# ==============================================================================
# Frontend Configuration (OPTIONAL - generated by init.sh with these defaults)
# ==============================================================================
