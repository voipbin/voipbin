API_URL=https://api.voipbin.test:8443/

# WebSocket URL used by square-admin and square-talk
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
WEBSOCKET_URL=wss://api.voipbin.test:8443/v1.0/ws

# SIP registrar WebSocket URL used by square-talk
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
REGISTRAR_URL=wss://sip.voipbin.test:5066

# SIP registrar domain used by square-admin and square-talk
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
REGISTRAR_DOMAIN=registrar.voipbin.test

# Conference WebSocket URL used by square-meet
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
CONFERENCE_URL=wss://conference.voipbin.test

# Conference domain used by square-meet
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
CONFERENCE_DOMAIN=conference.voipbin.test

# ==============================================================================
# Domain names for extension and trunk registration
# ==============================================================================
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
DOMAIN_NAME_EXTENSION=registrar.voipbin.test
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
DOMAIN_NAME_TRUNK=trunk.voipbin.test

# SIP TLS certificates path (optional, for TLS SIP)
CERTS_PATH=./certs

# ==============================================================================
# Telephony Providers (OPTIONAL - for PSTN functionality)
# ==============================================================================
# Twilio credentials for phone number provisioning
TWILIO_SID=
TWILIO_API_KEY=

# Telnyx credentials for phone numbers and messaging
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PROFILE_ID=

# MessageBird for SMS
MESSAGEBIRD_API_KEY=

# ==============================================================================
# Email Providers (OPTIONAL - for email features)
# ==============================================================================
SENDGRID_API_KEY=
MAILGUN_API_KEY=

# ==============================================================================
# AI/ML Services (OPTIONAL - for AI assistant features)
# ==============================================================================
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
XAI_API_KEY=

# ==============================================================================
# AWS (OPTIONAL - for transcription)
# ==============================================================================
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ==============================================================================
# Security & Storage (OPTIONAL)
# ==============================================================================
# JWT key shared by api-manager and storage-manager (must be the same for token verification)
JWT_KEY=your-random-jwt-secret-key
MYSQL_ROOT_PASSWORD=your-random-mysql-root-password
RABBITMQ_DEFAULT_USER=voipbin
RABBITMQ_DEFAULT_PASS=your-random-rabbitmq-password
AMI_USERNAME=voipbin
AMI_PASSWORD=your-random-ami-password
POSTGRES_PASSWORD=your-random-postgres-password

# Email verification base URL (used by customer-manager)
# derived from BASE_DOMAIN by init.sh - edit BASE_DOMAIN and re-run init, do not edit individually
EMAIL_VERIFY_BASE_URL=https://api.voipbin.test:8443

# ==============================================================================
# Analytics & Monitoring (OPTIONAL)
# ==============================================================================
# ClickHouse for event/timeline analytics.
# docker-compose.yml runs a local `clickhouse` service, so these point at it by
# default. timeline-manager (the only service that reads CLICKHOUSE_ADDRESS)
# runs its migrations against it at boot. Port 9000 is ClickHouse's native
# protocol, not HTTP. Override only if you run your own ClickHouse instance.
CLICKHOUSE_ADDRESS=clickhouse:9000
CLICKHOUSE_DATABASE=default

# Homer SIP capture server
HOMER_URI=
HOMER_API_ADDRESS=
HOMER_AUTH_TOKEN=
HOMER_WHITELIST=

# PSTN provider IPs whitelist (comma-separated)
# Defaults to HOST_EXTERNAL_IP so local PSTN-style calls work out of the box
# Add additional IPs separated by commas if needed
PSTN_WHITELIST_IPS=

# ==============================================================================
# RAG (OPTIONAL - for knowledge base features)
# ==============================================================================
# rag-manager was re-founded upstream: OpenAI embeddings + GCS .gob blob storage
# became Vertex AI embeddings + PostgreSQL/pgvector. The old GCS_BUCKET /
# GCS_EMBEDDINGS_PATH / RAG_DOCS_BASE_PATH / OPENAI_EMBEDDING_MODEL /
# RAG_LLM_MODEL / RAG_CHUNK_MAX_TOKENS variables no longer exist in its config
# and were removed. It now reads project/region/bucket from the GCP block above,
# and its PostgreSQL DSN is set in docker-compose.yml against the local
# `postgres` (pgvector) service. RAG_TOP_K is the only rag-specific knob left.
RAG_TOP_K=5

# ==============================================================================
# Scheduled Jobs (OPTIONAL - VOIP-1281)
# ==============================================================================
# schedule-manager runs the platform's internal cron (number renewal, execution
# audit-row pruning, and an in-stack DB backup) — see README.md "Scheduled Jobs".
# SCHEDULE_BACKUP_HOST_DIR is where its mysqldump+gzip backups land on the host;
# compose default is used unless you override this.
SCHEDULE_BACKUP_HOST_DIR=./backups/scheduled-db

# ==============================================================================
# Dev/Test Seed Data (OPTIONAL)
# ==============================================================================
# Set to "true" to auto-create a test customer/admin account and extensions
# 1000/2000/3000 with well-known passwords, for local development only.
# Leave unset/false for any install exposed beyond localhost.
VOIPBIN_SANDBOX_DEV_SEED=false
